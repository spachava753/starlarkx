load("assert.star", "assert")

assert.eq(enumerate(iterable=["a", "b"]), [(0, "a"), (1, "b")])
assert.eq(enumerate(["a", "b"], start=-2), [(-2, "a"), (-1, "b")])
assert.eq(enumerate(start=3, iterable=("a", "b")), [(3, "a"), (4, "b")])
assert.eq(enumerate(**{"iterable": ["a"]}, **{"start": 2}), [(2, "a")])
assert.eq(enumerate(iterable={"a": 1, "b": 2}, start=4), [(4, "a"), (5, "b")])
assert.eq(enumerate(iterable="ab".elems()), [(0, "a"), (1, "b")])
assert.eq(enumerate(iterable=[], start=2), [])
assert.fails(lambda: enumerate(start=2), "missing argument for iterable")
assert.fails(lambda: enumerate([], iterable=[]), "multiple values")
assert.fails(lambda: enumerate([], 1, start=2), "multiple values")
assert.fails(lambda: enumerate([], unknown=2), "unexpected keyword")
assert.fails(lambda: enumerate(iterable="ab"), "want iterable")
assert.fails(lambda: enumerate(iterable=None), "want iterable")
assert.fails(lambda: enumerate(iterable=[], start=None), "want int")
assert.fails(lambda: enumerate(iterable=[], start=True), "want int")
assert.fails(lambda: enumerate([], 0, 1), "at most 2")

assert.eq("a,b,c".split(sep=",", maxsplit=1), ["a", "b,c"])
assert.eq("a,b,c".rsplit(maxsplit=1, sep=","), ["a,b", "c"])
assert.eq("a,b,c".split(",", maxsplit=1), ["a", "b,c"])
assert.eq("a,b,c".rsplit(",", maxsplit=1), ["a,b", "c"])
assert.eq("  a  b  c  ".split(maxsplit=1), ["a", "b  c  "])
assert.eq("  a  b  c  ".rsplit(maxsplit=1), ["  a  b", "c"])
assert.eq("a,b".split(**{"sep": ","}, **{"maxsplit": 1}), ["a", "b"])

def test_split_keywords():
    for text in ["", "  ", "  a  b  ", "a,b,c", "é,Ω", "é\x00Ω", "é"[0]]:
        for method in [text.split, text.rsplit]:
            for sep in [None, ",", "é", "\x00"]:
                for limit in [-2, -1, 0, 1, 10]:
                    assert.eq(method(sep=sep, maxsplit=limit), method(sep, limit))
            assert.fails(lambda: method(",", sep=","), "multiple values")
            assert.fails(lambda: method(",", 1, maxsplit=2), "multiple values")
            assert.fails(lambda: method(unknown=1), "unexpected keyword")
            assert.fails(lambda: method(sep=""), "empty separator")
            assert.fails(lambda: method(sep=1), "want string")
            assert.fails(lambda: method(maxsplit=None), "want int")
            assert.fails(lambda: method(maxsplit=True), "want int")
            assert.fails(lambda: method(",", 1, 2), "at most 2")

test_split_keywords()

assert.eq("banana".replace("a", "o", count=2), "bonona")
assert.eq("banana".replace("a", "o", count=0), "banana")
assert.eq("banana".replace("a", "o", count=-2), "bonono")
assert.eq("éΩ".replace("", "-", count=2), "-é-Ω")
assert.eq("éΩ".replace("", "-", **{"count": 3}), "-é-Ω-")
assert.eq("é".replace("é"[0], "", count=1), "é"[1])
assert.eq("é".split(sep="é"[0]), ["", "é"[1]])
assert.fails(lambda: "a".replace(old="a", new="b"), "at least 2")
assert.fails(lambda: "a".replace("a", new="b"), "at least 2")
assert.fails(lambda: "a".replace("a", "b", old="a"), "unexpected keyword")
assert.fails(lambda: "a".replace("a", "b", new="b"), "unexpected keyword")
assert.fails(lambda: "a".replace("a", "b", unknown=1), "unexpected keyword")
assert.fails(lambda: "a".replace("a", "b", 1, count=2), "multiple values")
assert.fails(lambda: "".replace("a", "b", count=None), "want int")
assert.fails(lambda: "".replace("a", "b", count=True), "want int")
assert.fails(lambda: "a".replace("a", "b", 1, 2), "at most 3")

assert.eq("a\nb\n".splitlines(keepends=True), ["a\n", "b\n"])
assert.eq("a\nb\n".splitlines(keepends=False), ["a", "b"])
assert.eq("".splitlines(keepends=True), [])
# Keyword support preserves newline-only splitting; CR and Unicode separators remain.
assert.eq("a\r\nb\rc\u2028d".splitlines(keepends=False), ["a\r", "b\rc\u2028d"])
assert.eq("a\r\nb\rc\u2028d".splitlines(**{"keepends": True}), ["a\r\n", "b\rc\u2028d"])
assert.fails(lambda: "a".splitlines(False, keepends=True), "multiple values")
assert.fails(lambda: "a".splitlines(unknown=True), "unexpected keyword")
assert.fails(lambda: "".splitlines(keepends=1), "want bool")
assert.fails(lambda: "".splitlines(keepends=None), "want bool")
assert.fails(lambda: "a".splitlines(True, False), "at most 1")

# Existing decisions and positional-only parameters remain unchanged.
assert.eq(int(x="11", base=2), 3)
assert.fails(int, "missing argument")
assert.fails(lambda: len(x=[]), "unexpected keyword")
assert.fails(lambda: map(abs, [], strict=True), "keyword")
assert.fails(lambda: zip([], strict=True), "keyword")
